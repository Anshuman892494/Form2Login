{
  "name": "student-portal-mern",
  "version": "1.0.0",
  "description": "Production Ready MERN Stack Student Portal with Google Form Auto Registration",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "setup": "npm install && cd server && npm install && cd ../client && npm install --include=dev",
    "build": "cd client && npm run build",
    "start": "cd server && node server.js",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "keywords": [
    "mern",
    "student-portal",
    "express",
    "react",
    "mongodb",
    "google-forms"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "localtunnel": "^2.0.2"
  }
}
